<Window x:Class="MiApp.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión" Height="300" Width="400">
    <Grid x:Name="RootGrid">
        <StackPanel Margin="24">
            <TextBox x:Name="txtUsuario"
                     AutomationProperties.AutomationId="txtUsuario"
                     AutomationProperties.Name="Usuario" />
            <PasswordBox x:Name="txtClave"
                         AutomationProperties.AutomationId="txtClave"
                         AutomationProperties.Name="Contraseña" />
            <Button x:Name="btnIngresar"
                    AutomationProperties.AutomationId="btnIngresar"
                    Content="Ingresar" />
            <!-- Botón sin x:Name ni AutomationId: debe salir como inestable -->
            <Button Content="Cancelar" />
            <Label x:Name="lblError" Content="" />
        </StackPanel>
    </Grid>
</Window>
